<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Syncrowatch.App.Files"
        x:Class="Syncrowatch.App.Files.FilesWindow"
        x:DataType="vm:FilesViewModel"
        x:CompileBindings="True"
        Title="Syncrowatch files"
        Width="780" Height="520"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <FontFamily x:Key="MonoFont">JetBrains Mono NL, Consolas, DejaVu Sans Mono, monospace</FontFamily>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBox.fileList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem.fileRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BrandParchmentBrush}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border x:Name="rowChrome"
                    Background="{TemplateBinding Background}"
                    MinHeight="30">
              <ContentPresenter Margin="12,5,8,5"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
            <Rectangle Width="2" Fill="{DynamicResource BrandEmberBrush}" HorizontalAlignment="Left"
                       IsVisible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem.fileRow:pointerover /template/ Border#rowChrome">
      <Setter Property="Background" Value="{DynamicResource BrandSurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem.fileRow:selected /template/ Border#rowChrome">
      <Setter Property="Background" Value="{DynamicResource BrandSurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BrandParchmentBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandAshBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="actionChrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ Border#actionChrome">
      <Setter Property="Background" Value="{DynamicResource BrandSurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandParchmentBrush}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ Border#actionChrome">
      <Setter Property="Background" Value="{DynamicResource BrandSurfacePressBrush}" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ Border#actionChrome">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="TextBlock.sidePath">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource BrandParchmentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.ashHint">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource BrandAshBrush}" />
    </Style>
    <Style Selector="TextBlock.timelineAuthor">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BrandParchmentBrush}" />
    </Style>
    <Style Selector="TextBlock.timelineSha">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource BrandAshBrush}" />
    </Style>
  </Window.Styles>

  <Grid Margin="16" RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="300,*" ColumnSpacing="16">

      <Grid Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding HasFiles}">
        <Border Grid.Row="0" BorderBrush="{DynamicResource BrandLineBrush}" BorderThickness="1"
                CornerRadius="3" Background="{DynamicResource BrandInk2Brush}" Margin="0,0,0,8" Padding="8,5">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="=&gt;" FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{DynamicResource BrandAshBrush}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding FilterText}" Watermark="search files..."
                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" Classes="fileList" ItemsSource="{Binding VisibleFiles}" SelectedItem="{Binding SelectedFile}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileEntryViewModel">
              <Grid ColumnDefinitions="18,*" ToolTip.Tip="{Binding StatusText}">
                <Panel Width="14" Height="14" VerticalAlignment="Center">
                  <Ellipse Width="12" Height="12" StrokeThickness="1.3"
                           Stroke="{DynamicResource BrandParchmentBrush}"
                           IsVisible="{Binding IsClean}" />
                  <Panel IsVisible="{Binding IsPendingBatch}">
                    <Ellipse Width="12" Height="12" StrokeThickness="1.3"
                             Stroke="{DynamicResource BrandParchmentBrush}" />
                    <Path Data="M 6,1 A 5,5 0 0 0 6,11 Z" Fill="{DynamicResource BrandParchmentBrush}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" />
                  </Panel>
                  <Panel IsVisible="{Binding IsUnpushed}">
                    <Rectangle Width="10" Height="10" StrokeThickness="1.3"
                               Stroke="{DynamicResource BrandParchmentBrush}" />
                    <Rectangle Width="4" Height="4" Fill="{DynamicResource BrandParchmentBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                  </Panel>
                </Panel>
                <TextBlock Grid.Column="1" Classes="sidePath" Text="{Binding Path}" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <StackPanel Grid.Column="0" IsVisible="{Binding !HasFiles}" MaxWidth="260"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <Image Source="avares://syncrowatch/Assets/empty/empty-files.png" Width="142"
               HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock Text="Nothing watched yet" FontFamily="{StaticResource MonoFont}" FontSize="12"
                   Foreground="{DynamicResource BrandParchmentBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Files from the watched folder will land here after the first sync." FontSize="11"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource BrandAshBrush}" />
      </StackPanel>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding HasFiles}">
        <TextBlock Grid.Row="0" Text="{Binding SelectedFile.Path}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                   FontWeight="SemiBold" Foreground="{DynamicResource BrandParchmentBrush}"
                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSelection}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
          <Button Classes="secondary" Content="Copy link" Command="{Binding CopyLinkCommand}" />
          <TextBlock Classes="ashHint" Text="{Binding LinkHint}" VerticalAlignment="Center"
                     IsVisible="{Binding HasLinkHint}" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
          <ItemsControl ItemsSource="{Binding Timeline}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CommitEntryViewModel">
                <Border Padding="0,7" BorderBrush="{DynamicResource BrandLineBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="20,*">
                    <Panel>
                      <Rectangle Width="1" Fill="{DynamicResource BrandLineBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                      <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                               Fill="{DynamicResource BrandEmberBrush}"
                               IsVisible="{Binding IsLatest}" />
                      <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                               Fill="{DynamicResource BrandInk2Brush}" StrokeThickness="1.3"
                               Stroke="{DynamicResource BrandAshBrush}"
                               IsVisible="{Binding !IsLatest}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,8,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="timelineAuthor" Text="{Binding Author}" />
                        <TextBlock Grid.Column="1" Classes="ashHint" Text="{Binding TimeText}" Margin="12,0,0,0" />
                      </Grid>
                      <TextBlock Text="{Binding Subject}" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource BrandParchmentBrush}" />
                      <TextBlock Classes="timelineSha" Text="{Binding ShortSha}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Classes="ashHint" Text="Select a file to see its history" FontSize="12"
                   IsVisible="{Binding !HasSelection}" />
      </Grid>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" Spacing="10"
                IsVisible="{Binding HasError}">
      <TextBlock Text=";" FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrandEmberBrush}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource BrandParchmentBrush}" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
