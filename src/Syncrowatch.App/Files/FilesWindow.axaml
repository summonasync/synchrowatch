<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Syncrowatch.App.Files"
        x:Class="Syncrowatch.App.Files.FilesWindow"
        x:DataType="vm:FilesViewModel"
        x:CompileBindings="True"
        Title="Syncrowatch files"
        Width="780" Height="520"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16" RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="300,*" ColumnSpacing="16">
      <Grid Grid.Column="0" RowDefinitions="Auto,*">
        <TextBox Grid.Row="0" Watermark="Filter files" Text="{Binding FilterText}" Margin="0,0,0,8" />
        <ListBox Grid.Row="1" ItemsSource="{Binding VisibleFiles}" SelectedItem="{Binding SelectedFile}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileEntryViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#606060"
                           Margin="10,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="{Binding SelectedFile.Path}" FontWeight="SemiBold" FontSize="13"
                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSelection}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
          <Button Content="Copy link" Command="{Binding CopyLinkCommand}" />
          <TextBlock Text="{Binding LinkHint}" FontSize="11" Foreground="Gray"
                     VerticalAlignment="Center" IsVisible="{Binding HasLinkHint}" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
          <ItemsControl ItemsSource="{Binding Timeline}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CommitEntryViewModel">
                <Border Padding="0,7" BorderBrush="#33808080" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="140,72,*,80">
                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="Gray" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="{Binding Subject}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="3" Text="{Binding ShortSha}" FontFamily="Consolas, DejaVu Sans Mono, monospace"
                               FontSize="11" Foreground="#606060" HorizontalAlignment="Right" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="Select a file to see its history" Foreground="Gray" FontSize="12"
                   IsVisible="{Binding !HasSelection}" />
      </Grid>
    </Grid>

    <TextBlock Grid.Row="1" Margin="0,10,0,0"
               Text="{Binding ErrorMessage}"
               Foreground="Crimson"
               TextWrapping="Wrap"
               IsVisible="{Binding HasError}" />
  </Grid>
</Window>
