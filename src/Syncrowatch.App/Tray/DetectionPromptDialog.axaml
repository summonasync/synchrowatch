<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Syncrowatch.App.Tray"
        x:Class="Syncrowatch.App.Tray.DetectionPromptDialog"
        x:DataType="vm:DetectionPromptViewModel"
        x:CompileBindings="True"
        Title="Local changes found"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Local changes found" FontSize="16" FontWeight="SemiBold" />
    <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Sync now" Command="{Binding SyncNowCommand}" />
      <Button Content="Later" Command="{Binding LaterCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
