<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Syncrowatch.App.Brand">
  <SolidColorBrush x:Key="BrandInkBrush" Color="#0B0D0C" />
  <SolidColorBrush x:Key="BrandInk2Brush" Color="#121614" />
  <SolidColorBrush x:Key="BrandParchmentBrush" Color="#E8E4D9" />
  <SolidColorBrush x:Key="BrandAshBrush" Color="#8A9089" />
  <SolidColorBrush x:Key="BrandEmberBrush" Color="#FF6B35" />
  <SolidColorBrush x:Key="BrandLineBrush" Color="#232A26" />
</ResourceDictionary>
