<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Syncrowatch.App.History"
        x:Class="Syncrowatch.App.History.HistoryWindow"
        x:DataType="vm:HistoryViewModel"
        x:CompileBindings="True"
        Title="Syncrowatch history"
        Width="660" Height="480"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <RadioButton GroupName="historyFilter" Content="All" IsChecked="{Binding ShowAll}" MinWidth="56" />
      <RadioButton GroupName="historyFilter" Content="Pulled" IsChecked="{Binding ShowPulled}" />
      <RadioButton GroupName="historyFilter" Content="Pushed" IsChecked="{Binding ShowPushed}" />
      <RadioButton GroupName="historyFilter" Content="Merges" IsChecked="{Binding ShowMerges}" />
      <RadioButton GroupName="historyFilter" Content="Conflicts" IsChecked="{Binding ShowConflicts}" />
      <RadioButton GroupName="historyFilter" Content="Failures" IsChecked="{Binding ShowFailures}" />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Margin="12,0,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryEntryViewModel">
            <Border Padding="0,7" BorderBrush="#33808080" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="86,72,*,200">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="Gray" FontSize="11" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Text="{Binding Files}" FontSize="11" Foreground="#606060"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="6" IsVisible="{Binding HasPendingConflicts}">
      <TextBlock Text="Waiting for your pick" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding PendingConflicts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PendingConflictViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Path}" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="Gray" />
              <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="Gray" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBlock Grid.Row="3" Margin="0,10,0,0"
               Text="{Binding ErrorMessage}"
               Foreground="Crimson"
               TextWrapping="Wrap"
               IsVisible="{Binding HasError}" />
  </Grid>
</Window>
