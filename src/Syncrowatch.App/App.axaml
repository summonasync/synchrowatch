<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Syncrowatch.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcon Icon="avares://syncrowatch/Assets/syncrowatch-tray.png" ToolTipText="Syncrowatch">
      <TrayIcon.Menu>
        <NativeMenu>
          <NativeMenuItem Header="Sync now" />
          <NativeMenuItem Header="Open folder" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Exit" />
        </NativeMenu>
      </TrayIcon.Menu>
    </TrayIcon>
  </TrayIcon.Icons>
</Application>
